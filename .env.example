# Application
APP_NAME="RAG Foundry Engine"
ENVIRONMENT="local"

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=3600

# Qdrant Vector DB
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="knowledge_base"
EMBEDDING_DIMENSION=384

# LLM & Embeddings Provider
TEI_URL="http://localhost:8080"

OPENAI_API_KEY="sk-scrap-for-free!"
OPENAI_MODEL="gpt-5.6-sol"

# Options: "openai", "vllm"
LLM_PROVIDER="openai"

# Langfuse DB
LANGFUSE_DB_USER="postgres"
LANGFUSE_DB_PASSWORD="postgres_secret_password_123"
LANGFUSE_DB_NAME="langfuse"

# Langfuse Clickhouse
LANGFUSE_CLICKHOUSE_USER="clickhouse"
LANGFUSE_CLICKHOUSE_PASSWORD="clickhouse_secret_password_123"
LANGFUSE_CLICKHOUSE_DB="default"

# MinIO
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin_secret_password_123"
LANGFUSE_S3_BUCKET="langfuse"

# Langfuse Server
LANGFUSE_NEXTAUTH_SECRET="mysecretkeyforauthsuperbased123"
LANGFUSE_SALT="supersecretsaltforpasswords123"
LANGFUSE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
LANGFUSE_NEXTAUTH_URL="http://localhost:3001"
LANGFUSE_TELEMETRY_ENABLED=false

# Langfuse App Tracing
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# Langfuse has lots of dependencies, uncomment to enable minio and clickhouse.
# COMPOSE_PROFILES=langfuse
